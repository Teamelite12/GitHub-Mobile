{
  "name": "Strict Main Protection",
  "enforcement": "active",
  "bypass_actors": [],
  "target": {
    "branch": ["main"]
  },
  "rules": {
    "require_pull_request_reviews": true,
    "required_approving_review_count": 1,
    "require_status_checks": true,
    "required_status_checks": ["ci/test", "lint/check"],
    "require_signed_commits": true,
    "require_linear_history": true,
    "enforce_admins": true,
    "restrictions": {
      "users": [],
      "teams": [],
      "apps": [],
      "role": ["admin"]  // Only admins can push
    }
  }
}
